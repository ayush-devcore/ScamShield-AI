DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USERNAME:CHANGE_ME_PASSWORD@127.0.0.1:5432/CHANGE_ME_DATABASE
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY_FROM_FERNET_GENERATE_KEY
FRONTEND_ORIGIN=http://localhost:5173
OPENROUTER_API_KEY=REPLACE_WITH_SERVER_SIDE_OPENROUTER_KEY
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TIMEOUT_SECONDS=8
OPENROUTER_MAX_INPUT_CHARS=10000
OPENROUTER_MAX_OUTPUT_TOKENS=420
OPENROUTER_PER_USER_HOURLY_LIMIT=5
OPENROUTER_PER_USER_DAILY_LIMIT=20
OPENROUTER_GLOBAL_DAILY_LIMIT=500
OPENROUTER_MAX_CONCURRENCY=8
SANDBOX_RUNTIME_ENABLED=false
SANDBOX_NETWORK_VERIFIED=false
# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SANDBOX_ENCRYPTION_KEY=
SANDBOX_JOB_TIMEOUT_SECONDS=90
